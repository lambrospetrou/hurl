+  println!("cargo:rerun-if-env-changed=LIBXML2_BINDINGS");
+  if let (Ok(b), Ok(dir)) = (env::var("LIBXML2_BINDINGS"), env::var("LIBXML2_LIBDIR")) {
+    fs::copy(b, &bindings_path).expect("Failed to copy LIBXML2_BINDINGS");
+    println!("cargo:rustc-link-search=native={dir}");
+    println!("cargo:rustc-link-lib=static=xml2");
+    return;
+  }
   if let Some(probed_lib) = find_libxml2() {
     // if we could find header files, generate fresh bindings from them
     generate_bindings(probed_lib.include_paths, &bindings_path);
